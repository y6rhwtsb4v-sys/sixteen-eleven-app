# Builds the iOS app and sends it to TestFlight.
#
# Signing uses an App Store *distribution* certificate and an App Store
# provisioning profile, made through the App Store Connect API key. Neither
# needs a registered iPhone (automatic signing does, which is why it is not
# used here).
#
# The certificate's private key has to be the same on every build, and Apple
# allows only a few distribution certificates per team, so it is made once:
#   - IOS_CERT_PASSWORD (a secret you choose) must be set.
#   - First run, with no IOS_SIGNING_B64 secret: a certificate is made, and the
#     key and certificate are attached to the run as "ios-signing", ENCRYPTED
#     with IOS_CERT_PASSWORD. Put that file's text into a secret IOS_SIGNING_B64.
#   - Every later run decrypts IOS_SIGNING_B64 and uses the same certificate.
#
# Run from the native folder:  fastlane ios beta
require 'base64'
require 'openssl'

default_platform(:ios)

ROOT = File.expand_path('..', __dir__)
BUNDLE_ID = 'com.sixteeneleven.bible'

platform :ios do
  lane :beta do
    pass = ENV['IOS_CERT_PASSWORD'].to_s
    UI.user_error!('Add the IOS_CERT_PASSWORD secret first (a long password you make up).') if pass.empty?

    key_path = File.join(ROOT, 'AuthKey.p8')
    File.write(key_path, ENV.fetch('ASC_KEY_P8'))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: key_path
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # a keychain just for this run, unlocked, that codesign can use unattended
    setup_ci(force: true)
    keychain = File.expand_path('~/Library/Keychains/fastlane_tmp_keychain-db')

    sign_dir = File.join(ROOT, 'signing')
    FileUtils.mkdir_p(sign_dir)
    pem = File.join(sign_dir, 'dist-key.pem')
    cer = File.join(sign_dir, 'dist.cer')
    bundle = ENV['IOS_SIGNING_B64'].to_s

    if bundle.empty?
      UI.message('No IOS_SIGNING_B64 yet: making the distribution certificate')
      key = OpenSSL::PKey::RSA.new(2048)
      csr = OpenSSL::X509::Request.new
      csr.version = 0
      csr.subject = OpenSSL::X509::Name.parse('/CN=Sixteen Eleven/O=Sixteen Eleven/C=US')
      csr.public_key = key.public_key
      csr.sign(key, OpenSSL::Digest::SHA256.new)
      made = Spaceship::ConnectAPI::Certificate.create(
        certificate_type: Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
        csr_content: csr.to_pem
      )
      File.write(pem, key.to_pem)
      File.binwrite(cer, Base64.decode64(made.certificate_content))
      out = File.join(ROOT, 'ios-signing')
      FileUtils.mkdir_p(out)
      sh("cd #{sign_dir.shellescape} && tar -cf - dist-key.pem dist.cer | " \
         "openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass env:IOS_CERT_PASSWORD | " \
         "base64 > #{File.join(out, 'IOS_SIGNING_B64.txt').shellescape}")
    else
      File.write(File.join(sign_dir, 'bundle.b64'), bundle)
      sh("cd #{sign_dir.shellescape} && base64 -D -i bundle.b64 | " \
         "openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:IOS_CERT_PASSWORD | tar -xf -")
    end

    # the key and certificate go in separately; the keychain pairs them
    sh("security import #{pem.shellescape} -k #{keychain.shellescape} -t priv -f openssl " \
       "-T /usr/bin/codesign -T /usr/bin/security")
    sh("security import #{cer.shellescape} -k #{keychain.shellescape}")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' #{keychain.shellescape} > /dev/null")
    FileUtils.rm_f([pem, File.join(sign_dir, 'bundle.b64')])

    # an App Store profile for the app; made the first time, reused after
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      force: bundle.empty?,
      output_path: sign_dir
    )
    profile = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: File.join(ROOT, 'ios/App/App.xcodeproj'),
      use_automatic_signing: false,
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile,
      targets: ['App']
    )
    build_app(
      project: File.join(ROOT, 'ios/App/App.xcodeproj'),
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: File.join(ROOT, 'build'),
      output_name: 'SixteenEleven.ipa',
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} " \
              "MARKETING_VERSION=#{ENV.fetch('APP_VERSION', '1.0.0')} " \
              "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      export_options: {
        signingStyle: 'manual',
        teamID: ENV['APPLE_TEAM_ID'],
        provisioningProfiles: { BUNDLE_ID => profile }
      }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  # Opens the newest build to testers, two ways:
  #   "Team"            internal: everyone on the App Store Connect account, at
  #                     once, no review (up to 100 people).
  #   "Public testers"  external: a public link anyone can open, once Apple's
  #                     beta review passes (usually within a day). Needs
  #                     BETA_CONTACT_PHONE; without it the group is made but not
  #                     submitted.
  # The public link is written to the run's summary page.
  lane :testers do
    key_path = File.join(ROOT, 'AuthKey.p8')
    File.write(key_path, ENV.fetch('ASC_KEY_P8'))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: key_path
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app #{BUNDLE_ID} in App Store Connect") unless app

    # the newest build, once Apple has finished processing it
    build = nil
    60.times do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: '-uploadedDate', limit: 1).first
      break if build && build.processed?
      UI.message('Waiting for Apple to finish processing the newest build...')
      sleep 30
    end
    UI.user_error!('No processed build yet; try again in a few minutes') unless build && build.processed?
    UI.success("Newest build: #{build.app_version} (#{build.version})")

    groups = app.get_beta_groups
    team = groups.find { |g| g.name == 'Team' }
    unless team
      # fastlane's helper always sends public-link settings, which Apple
      # refuses for an internal group, so this one is posted directly
      Spaceship::ConnectAPI.client.test_flight_request_client.post('v1/betaGroups', {
        data: {
          type: 'betaGroups',
          attributes: { name: 'Team', isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { type: 'apps', id: app.id } } }
        }
      })
      team = app.get_beta_groups.find { |g| g.name == 'Team' }
    end
    people = Spaceship::ConnectAPI::User.all.map do |u|
      { email: u.email || u.username, firstName: u.first_name.to_s, lastName: u.last_name.to_s }
    end.reject { |p| p[:email].to_s.empty? }
    unless people.empty?
      Spaceship::ConnectAPI.post_bulk_beta_tester_assignments(beta_group_id: team.id, beta_testers: people)
    end
    UI.success("Team group: #{people.map { |p| p[:email] }.join(', ')}")

    pub = groups.find { |g| g.name == 'Public testers' } ||
          app.create_beta_group(group_name: 'Public testers', public_link_enabled: true,
                                public_link_limit: 10_000, public_link_limit_enabled: false)
    unless pub.public_link_enabled
      pub.update(attributes: { publicLinkEnabled: true, publicLinkLimitEnabled: false })
    end

    phone = ENV['BETA_CONTACT_PHONE'].to_s.strip
    opts = {
      api_key: api_key,
      distribute_only: true,
      app_identifier: BUNDLE_ID,
      app_platform: 'ios',
      app_version: build.app_version,
      build_number: build.version,
      distribute_external: true,
      groups: ['Public testers'],
      notify_external_testers: true,
      uses_non_exempt_encryption: false,
      changelog: ENV.fetch('WHAT_TO_TEST', 'Read, study and listen. Try the narrated chapters with the screen locked, and tell us anything that reads or sounds wrong.'),
      localized_app_info: {
        'default' => {
          feedback_email: 'scribe@sixteeneleven.bible',
          marketing_url: 'https://app.sixteeneleven.bible',
          privacy_policy_url: 'https://app.sixteeneleven.bible/privacy.html',
          description: 'Sixteen Eleven: the King James Bible with the Apocrypha, set like a book, with study tools and a narrated Bible.'
        }
      },
      submit_beta_review: !phone.empty?
    }
    # Apple's reviewers need someone to call; without a number, nothing is sent
    unless phone.empty?
      opts[:beta_app_review_info] = {
        contact_email: 'scribe@sixteeneleven.bible',
        contact_first_name: ENV.fetch('BETA_CONTACT_FIRST', 'Tyrell'),
        contact_last_name: ENV.fetch('BETA_CONTACT_LAST', 'Powe'),
        contact_phone: phone,
        demo_account_required: false,
        notes: 'No sign-in. The narration plays from any recorded chapter (Psalms and John are free). Purchases use the sandbox.'
      }
    end
    upload_to_testflight(opts)

    pub = app.get_beta_groups.find { |g| g.name == 'Public testers' }
    link = pub && pub.public_link
    lines = ["## TestFlight",
             "Build #{build.app_version} (#{build.version})",
             "Team (internal, now): #{people.map { |p| p[:email] }.join(', ')}",
             "Public link: #{link || '(not issued yet)'}",
             phone.empty? ? 'Not sent for beta review: add BETA_CONTACT_PHONE.' : 'Sent for beta review; the public link works once it passes.']
    UI.success(lines.join("\n"))
    File.write(ENV['GITHUB_STEP_SUMMARY'], lines.join("\n\n") + "\n") if ENV['GITHUB_STEP_SUMMARY']
  end
end
