# Builds the iOS app and sends it to TestFlight.
#
# Signing uses an App Store *distribution* certificate and an App Store
# provisioning profile, made through the App Store Connect API key. Neither
# needs a registered iPhone (automatic signing does, which is why it is not
# used here).
#
# The certificate's private key has to be the same on every build, and Apple
# allows only a few distribution certificates per team, so it is made once:
#   - IOS_CERT_PASSWORD (a secret you choose) must be set.
#   - First run, with no IOS_SIGNING_B64 secret: a certificate is made, and the
#     key and certificate are attached to the run as "ios-signing", ENCRYPTED
#     with IOS_CERT_PASSWORD. Put that file's text into a secret IOS_SIGNING_B64.
#   - Every later run decrypts IOS_SIGNING_B64 and uses the same certificate.
#
# Run from the native folder:  fastlane ios beta
require 'base64'
require 'openssl'

default_platform(:ios)

ROOT = File.expand_path('..', __dir__)
BUNDLE_ID = 'com.sixteeneleven.bible'

platform :ios do
  lane :beta do
    pass = ENV['IOS_CERT_PASSWORD'].to_s
    UI.user_error!('Add the IOS_CERT_PASSWORD secret first (a long password you make up).') if pass.empty?

    key_path = File.join(ROOT, 'AuthKey.p8')
    File.write(key_path, ENV.fetch('ASC_KEY_P8'))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: key_path
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # a keychain just for this run, unlocked, that codesign can use unattended
    setup_ci(force: true)
    keychain = File.expand_path('~/Library/Keychains/fastlane_tmp_keychain-db')

    sign_dir = File.join(ROOT, 'signing')
    FileUtils.mkdir_p(sign_dir)
    pem = File.join(sign_dir, 'dist-key.pem')
    cer = File.join(sign_dir, 'dist.cer')
    bundle = ENV['IOS_SIGNING_B64'].to_s

    if bundle.empty?
      UI.message('No IOS_SIGNING_B64 yet: making the distribution certificate')
      key = OpenSSL::PKey::RSA.new(2048)
      csr = OpenSSL::X509::Request.new
      csr.version = 0
      csr.subject = OpenSSL::X509::Name.parse('/CN=Sixteen Eleven/O=Sixteen Eleven/C=US')
      csr.public_key = key.public_key
      csr.sign(key, OpenSSL::Digest::SHA256.new)
      made = Spaceship::ConnectAPI::Certificate.create(
        certificate_type: Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
        csr_content: csr.to_pem
      )
      File.write(pem, key.to_pem)
      File.binwrite(cer, Base64.decode64(made.certificate_content))
      out = File.join(ROOT, 'ios-signing')
      FileUtils.mkdir_p(out)
      sh("cd #{sign_dir.shellescape} && tar -cf - dist-key.pem dist.cer | " \
         "openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass env:IOS_CERT_PASSWORD | " \
         "base64 > #{File.join(out, 'IOS_SIGNING_B64.txt').shellescape}")
    else
      File.write(File.join(sign_dir, 'bundle.b64'), bundle)
      sh("cd #{sign_dir.shellescape} && base64 -D -i bundle.b64 | " \
         "openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:IOS_CERT_PASSWORD | tar -xf -")
    end

    # the key and certificate go in separately; the keychain pairs them
    sh("security import #{pem.shellescape} -k #{keychain.shellescape} -t priv -f openssl " \
       "-T /usr/bin/codesign -T /usr/bin/security")
    sh("security import #{cer.shellescape} -k #{keychain.shellescape}")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' #{keychain.shellescape} > /dev/null")
    FileUtils.rm_f([pem, File.join(sign_dir, 'bundle.b64')])

    # an App Store profile for the app; made the first time, reused after
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      force: bundle.empty?,
      output_path: sign_dir
    )
    profile = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: File.join(ROOT, 'ios/App/App.xcodeproj'),
      use_automatic_signing: false,
      team_id: ENV.fetch('APPLE_TEAM_ID'),
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: 'Apple Distribution',
      profile_name: profile,
      targets: ['App']
    )
    build_app(
      project: File.join(ROOT, 'ios/App/App.xcodeproj'),
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: File.join(ROOT, 'build'),
      output_name: 'SixteenEleven.ipa',
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} " \
              "MARKETING_VERSION=#{ENV.fetch('APP_VERSION', '1.0.0')} " \
              "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      export_options: {
        signingStyle: 'manual',
        teamID: ENV['APPLE_TEAM_ID'],
        provisioningProfiles: { BUNDLE_ID => profile }
      }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
